@host = http://localhost:9090/api
@uri = {{host}}/productos

### INSERTAR
POST {{uri}}
Content-Type: application/json

{
    "sku": "COM-0002",
    "nombre_producto": "Atún Suli",
    "descripcion": "Atún",
    "precio_unitario": 500.00,
    "stock_actual": 32,
    "categoria": "Comida"
}
### Insertar con datos inválidos 
POST {{uri}}
Content-Type: application/json

{
    "sku": "her 01",
    "nombre_producto": "",
    "precio_unitario": -10,
    "stock_actual": 2.5,
    "categoria": ""
}

### Insertar con SKU ya usado
POST {{uri}}
Content-Type: application/json

{
    "sku": "HER-0001",
    "nombre_producto": "Otro destornillador",
    "precio_unitario": 3000,
    "stock_actual": 5,
    "categoria": "Herramientas"
}

### Producto que no existe 
   GET {{uri}}/5000

###


### Listar todos los productos 
GET {{uri}}

### Obtener producto por id
GET {{uri}}/1


### Actualizar precio y stock 
PUT {{uri}}/1
Content-Type: application/json

{
    "precio_unitario": 4800,
    "stock_actual": 28
}

### Actualizar nombre y descripción
PUT {{uri}}/8
Content-Type: application/json

{
    "nombre_producto": "Arroz Tio Pelón",
    "descripcion": "Arroz de 5kg"
}

### Eliminar producto
DELETE {{uri}}/3

###
